
/* THEME VARIABLE */
let themeStatus = 'light';

/* LOAD SAVED DATA */
function loadPreferences() {
    // Load theme
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
        document.body.classList.add('darkmode');
        themeStatus = 'dark';
    }

    // Load username
    const savedName = localStorage.getItem('username');
    if (savedName) {
        document.getElementById('myheading').textContent = Hello, ${savedName}!;
    }

    // Date & time
    document.getElementById('datetime').textContent =
        Current date & time: ${new Date().toLocaleString()};
}

/* TOGGLE THEME */
function toggleTheme() {
    if (themeStatus !== 'dark') {
        document.body.classList.add('darkmode');
        themeStatus = 'dark';
        localStorage.setItem('theme', 'dark');
    } else {
        document.body.classList.remove('darkmode');
        themeStatus = 'light';
        localStorage.setItem('theme', 'light');
    }
}

/* APPLY USER NAME */
function applyName() {
    const username = document.getElementById('username').value;
    document.getElementById('myheading').textContent = Hello, ${username}!;
    localStorage.setItem('username', username);
}

/* IMAGE SWITCHING */
function showKangaroo() {
    document.getElementById('mainImage').src = 'images/kangaroo.jpg';
    document.getElementById('imageText').innerHTML =
        `Kangaroos are iconic Australian animals known for their strength and agility.
        <br>
        <a id="imageLink" href="https://www.pexels.com/search/kangaroo/" target="_blank">
            Image source
        </a>`;
}

function showKoala() {
